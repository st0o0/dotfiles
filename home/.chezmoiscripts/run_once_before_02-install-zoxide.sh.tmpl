{{ if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
{{ if eq .chezmoi.os "linux" -}}
export PATH="${HOME}/.local/bin:${PATH}"
if ! command -v zoxide >/dev/null 2>&1; then
  mkdir -p "${HOME}/.local/bin"
  if SCRIPT="$(curl -fsSL https://raw.githubusercontent.com/ajeetdsouza/zoxide/main/install.sh 2>/dev/null)"; then
    sh -c "${SCRIPT}" || echo "warning: zoxide install failed, skipping" >&2
  else
    echo "warning: could not download zoxide installer, skipping" >&2
  fi
fi
{{ else if eq .chezmoi.os "darwin" -}}
command -v zoxide >/dev/null 2>&1 || brew install zoxide
{{ end -}}
{{ end -}}
