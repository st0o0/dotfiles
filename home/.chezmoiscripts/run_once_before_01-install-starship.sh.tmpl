{{ if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
{{ if eq .chezmoi.os "linux" -}}
export PATH="${HOME}/.local/bin:${PATH}"
if ! command -v starship >/dev/null 2>&1; then
  mkdir -p "${HOME}/.local/bin"
  if SCRIPT="$(curl -fsSL https://starship.rs/install.sh 2>/dev/null)"; then
    sh -c "${SCRIPT}" -- -y -b "${HOME}/.local/bin" || echo "warning: starship install failed, skipping" >&2
  else
    echo "warning: could not download starship installer, skipping" >&2
  fi
fi
{{ else if eq .chezmoi.os "darwin" -}}
command -v starship >/dev/null 2>&1 || brew install starship
{{ end -}}
{{ end -}}
