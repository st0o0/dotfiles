# Never deploy secrets
*id_rsa*
*id_ed25519*
*id_ansible*
*id_backup_*
*.pem
*.key
keys.txt
.netrc

# ── OS-specific filtering ───────────────────────────────────────────
# On Windows, ignore Linux-only files (keep .local/bin/dotfiles-shell.ps1)
{{- if eq .chezmoi.os "windows" }}
.bash_aliases
.bash_aliases.d/**
.config/kitty/**
.inputrc
.local/bin/install-cli-tools.sh
.local/bin/uninstall-cli-tools.sh
.local/bin/tmux-statusbar.sh
.local/bin/zsh-banner.sh
.local/share/starship/linux.toml
.nanorc
.tmux.conf
.zshrc
{{- end }}

# On Linux/macOS, ignore Windows-only files
{{- if ne .chezmoi.os "windows" }}
.local/bin/dotfiles-shell.ps1
.local/bin/psmux-statusbar.ps1
.local/share/starship/windows.toml
.psmux.conf
{{- end }}

# ── Profile-specific filtering (Linux only) ─────────────────────────
{{- if or (eq .profile "server") (eq .profile "devcontainer") }}
.bash_aliases.d/40-workstation.sh
.config/kitty/**
{{- end }}
{{- if eq .profile "devcontainer" }}
.local/bin/zsh-banner.sh
{{- end }}
{{- if eq .profile "workstation" }}
.bash_aliases.d/20-docker.sh
.bash_aliases.d/30-cd-shortcuts-server.sh
{{- end }}
{{- if ne .profile "devcontainer" }}
.bash_aliases.d/45-devcontainer.sh
{{- end }}
