# Never deploy secrets
*id_rsa*
*id_ed25519*
*id_ansible*
*id_backup_*
*.pem
*.key
keys.txt
.netrc

# ── OS-specific filtering ───────────────────────────────────────────
# On Windows, ignore Linux-only files
{{- if eq .chezmoi.os "windows" }}
.bash_aliases
.bash_aliases.d/**
.config/kitty/**
.inputrc
.local/bin/**
.nanorc
.tmux.conf
.zshrc
{{- end }}

# On Linux/macOS, ignore Windows-only files
{{- if ne .chezmoi.os "windows" }}
Documents/PowerShell/**
.psmux.conf
{{- end }}

# ── Profile-specific filtering (Linux only) ─────────────────────────
{{- if eq .profile "server" }}
.bash_aliases.d/40-workstation.sh
.config/kitty/**
{{- end }}
{{- if eq .profile "workstation" }}
.bash_aliases.d/20-docker.sh
.bash_aliases.d/30-cd-shortcuts-server.sh
{{- end }}
