# Managed by chezmoi — applies on every profile

set linenumbers
set softwrap
set tabsize 4
set autoindent
set constantshow
set mouse

include "/usr/share/nano/*.nanorc"
{{- if eq .chezmoi.os "darwin" }}
include "/opt/homebrew/share/nano/*.nanorc"
include "/usr/local/share/nano/*.nanorc"
{{- end }}
